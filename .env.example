# ---- Analytics ----
# Google Analytics 4 measurement ID (public). Leave unset to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (optional)
GOOGLE_SITE_VERIFICATION=

# ---- Contact form delivery ----
# Web3Forms access key (free, no submission-volume paywall at this scale).
# Get one at https://web3forms.com by entering your delivery email - they
# email back an access key instantly, no account/password needed.
# Must be NEXT_PUBLIC_ (client-exposed): Web3Forms' free tier rejects
# server-to-server submissions, so the form submits from the browser.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# ---- Anti-spam: Cloudflare Turnstile ----
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is public (client), secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Optional: distributed rate limiting (Upstash Redis) ----
# The form ships with an in-memory rate limiter. For strict limits across
# serverless instances, provision Upstash and wire @upstash/ratelimit.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
